# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=oauth2_staging
DATABASE_SSLMODE=disable

# JWT
JWT_ISSUER=https://staging-api.yourdomain.com

# Admin
ADMIN_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Migrations (auto-run on startup in staging)
AUTO_MIGRATE=true

# OpenTelemetry
OTEL_SERVICE_NAME=oauth-service-staging
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
