# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=oauth2_prod
DATABASE_SSLMODE=disable

# JWT
JWT_ISSUER=https://api.yourdomain.com

# Admin
ADMIN_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Migrations (manual in production — run: docker compose -f docker-compose.prod.yml exec oauth-api-prod ./migrate up)
AUTO_MIGRATE=false

# OpenTelemetry
OTEL_SERVICE_NAME=oauth-service-prod
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
